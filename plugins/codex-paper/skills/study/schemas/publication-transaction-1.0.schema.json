{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-paper.local/schemas/publication-transaction-1.0.schema.json",
  "title": "Codex Paper Publication Transaction 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transactionId", "workspaceId", "state", "paperKey", "paperId", "sourceRevisionId", "generationId", "targetPackageRelativePath", "manifestId", "manifestHash", "manifestFileSha256", "validationReportHash", "createdAt", "updatedAt", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "transactionId": { "type": "string", "pattern": "^pub-[a-f0-9]{32}$" },
    "workspaceId": { "type": "string", "pattern": "^ws-[a-f0-9]{12}-[a-f0-9]{12}-[a-f0-9]{32}$" },
    "state": { "enum": ["prepared", "generation_committed", "current_committed", "index_committed", "failed"] },
    "paperKey": { "type": "string", "pattern": "^p-[a-f0-9]{64}$" },
    "paperId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sourceRevisionId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "generationId": { "type": "string", "pattern": "^gen:sha256:[a-f0-9]{64}$" },
    "targetPackageRelativePath": { "type": "string", "pattern": "^sources/sha256-[a-f0-9]{64}/generations/gen-sha256-[a-f0-9]{64}/package$" },
    "manifestId": { "type": "string", "pattern": "^gm-sha256-[a-f0-9]{64}$" },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestFileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "validationReportHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 600 }
        }
      }
    }
  }
}

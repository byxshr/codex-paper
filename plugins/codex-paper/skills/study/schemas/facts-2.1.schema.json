{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-paper.local/schemas/facts-2.1.schema.json",
  "title": "Codex Paper Facts 2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "paperSlug", "parserVersion", "coreClaims", "resultClaims", "keyResults", "limitations"],
  "properties": {
    "schemaVersion": { "const": "2.1.0" },
    "paperSlug": { "type": "string", "minLength": 1 },
    "parserVersion": { "type": "string", "minLength": 1 },
    "coreClaims": { "type": "array", "items": { "$ref": "#/$defs/textFact" } },
    "resultClaims": { "type": "array", "items": { "$ref": "#/$defs/resultClaim" } },
    "keyResults": { "type": "array", "items": { "$ref": "#/$defs/keyResult" } },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/textFact" } }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ev-p\\d{3,}-[a-z]+-[a-f0-9]{10}$" }
    },
    "legacyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "quote"],
      "properties": {
        "section": { "type": "string" },
        "quote": { "type": "string" }
      }
    },
    "textFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence", "evidenceRefs"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/legacyEvidence" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "resultClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "dataset", "split", "languagePair", "metric", "value", "unit", "model", "comparator", "direction", "location", "evidenceRefs", "confidence"],
      "properties": {
        "task": { "type": ["string", "null"] },
        "dataset": { "type": ["string", "null"] },
        "split": { "type": ["string", "null"] },
        "languagePair": { "type": ["string", "null"] },
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "comparator": { "type": ["string", "null"] },
        "direction": { "enum": ["higher_is_better", "lower_is_better", "neutral"] },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "table"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "table": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "confidence": { "enum": ["high", "medium"] }
      }
    },
    "keyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "context", "evidence", "evidenceRefs"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/legacyEvidence" },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    }
  }
}

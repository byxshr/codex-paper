{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-paper.local/schemas/paper-current-1.0.schema.json",
  "title": "Codex Paper Current Record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "paperKey", "paperId", "sourceRevisionId", "generationId", "packageRelativePath"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "paperKey": { "pattern": "^p-[a-f0-9]{64}$" },
    "paperId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sourceRevisionId": { "pattern": "^sha256:[a-f0-9]{64}$" },
    "generationId": { "pattern": "^gen:sha256:[a-f0-9]{64}$" },
    "packageRelativePath": { "pattern": "^sources/sha256-[a-f0-9]{64}/generations/gen-sha256-[a-f0-9]{64}/package$" },
    "manifestId": { "pattern": "^gm-sha256-[a-f0-9]{64}$" },
    "manifestHash": { "pattern": "^[a-f0-9]{64}$" },
    "manifestFileSha256": { "pattern": "^[a-f0-9]{64}$" },
    "validationReportHash": { "pattern": "^[a-f0-9]{64}$" },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "dependentRequired": {
    "manifestId": ["manifestHash", "manifestFileSha256", "validationReportHash", "publishedAt"],
    "manifestHash": ["manifestId", "manifestFileSha256", "validationReportHash", "publishedAt"],
    "manifestFileSha256": ["manifestId", "manifestHash", "validationReportHash", "publishedAt"],
    "validationReportHash": ["manifestId", "manifestHash", "manifestFileSha256", "publishedAt"],
    "publishedAt": ["manifestId", "manifestHash", "manifestFileSha256", "validationReportHash"]
  }
}

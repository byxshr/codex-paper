{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-paper.local/schemas/paper-overlay-1.0.schema.json",
  "title": "Codex Paper Mutable Overlay 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tags", "progress", "annotations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "tags": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "progress": { "type": "object" },
    "annotations": { "type": "array", "maxItems": 10000 }
  }
}
